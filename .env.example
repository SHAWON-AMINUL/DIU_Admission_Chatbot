# Copy to .env to override. Every value here is the built-in default.

# Port 5433: the machine already runs an EnterpriseDB PostgreSQL on 5432.
DATABASE_URL=postgresql://diu:diu@localhost:5433/diu_admission

EMBEDDING_MODEL=BAAI/bge-m3
MODEL_NAME_TAG=bge-m3@1024
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001
# auto | mps | cpu   (mps = Apple Silicon GPU)
EMBEDDING_DEVICE=auto

# BGE-M3 subword tokens.
CHUNK_TARGET_TOKENS=300
CHUNK_OVERLAP_TOKENS=60
CHUNK_MAX_TOKENS=512

RETRIEVAL_TOP_K=10
RRF_K=60

# Generation (local Ollama; `ollama pull gemma3:4b`)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TEMPERATURE=0.1
GENERATION_TOP_K=5
MAX_HISTORY_TURNS=6
# Set false once scripts/seed.py is replaced with real DIU content.
CORPUS_IS_SYNTHETIC=true
